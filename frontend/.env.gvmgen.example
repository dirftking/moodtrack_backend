# Server-only S3-compatible storage configuration for video uploads.
# Prefer scripts/configure-supabase-storage.ps1 instead of editing secrets by hand.
# Copy to .env.gvmgen.local only when configuring manually. Never use VITE_ prefixes.
S3_PROVIDER=supabase
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=PROJECT_REGION
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=moodtrack-video-input

# Optional overrides
S3_PREFIX=incoming
S3_PRESIGN_TTL_SECONDS=900
S3_FORCE_PATH_STYLE=true
GVMGEN_MAX_UPLOAD_MB=50
