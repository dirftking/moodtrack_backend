# MoodTrack defaults to the local ACE-Step 1.5 service.
ACESTEP_PROVIDER=local
ACESTEP_LOCAL_API_URL=http://127.0.0.1:8001
ACESTEP_LOCAL_MODEL=acestep-v15-turbo

# Optional explicit cloud mode. Set ACESTEP_PROVIDER=cloud to use these values.
ACESTEP_API_URL=https://api.acemusic.ai
ACESTEP_API_KEY=
ACESTEP_MODEL=acemusic/acestep-v15-turbo
